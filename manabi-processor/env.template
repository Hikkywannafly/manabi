# Environment Variables Template
# Copy this to .env and fill in values

# =============================================================================
# API KEYS - Choose one of the following configurations:
# =============================================================================

# Option 1: Single shared key for both Quiz and Flashcard
# OPENROUTER_API_KEY=your_openrouter_api_key

# Option 2: Separate keys for Quiz and Flashcard (recommended)
# OPENROUTER_API_KEY_QUIZ=your_quiz_api_key
# OPENROUTER_API_KEY_FLASHCARD=your_flashcard_api_key
# OPENROUTER_API_KEY_EXPLANATION=your_explanation_api_key

# You can also mix: set shared key as fallback, then override specific ones
# OPENROUTER_API_KEY=shared_fallback_key
# OPENROUTER_API_KEY_QUIZ=specific_quiz_key  # Uses this for quiz
# (flashcard will use OPENROUTER_API_KEY as fallback)

# =============================================================================
# SUPABASE
# =============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# =============================================================================
# SECURITY
# =============================================================================
# API_SECRET_KEY=your_random_secret_key_for_auth

# =============================================================================
# OPTIONAL: Model Configuration
# =============================================================================
# DEFAULT_MODEL=google/gemini-2.0-flash-001

# Optional: Different models for Quiz vs Flashcard
# DEFAULT_MODEL_QUIZ=google/gemini-2.0-flash-001
# DEFAULT_MODEL_FLASHCARD=google/gemini-2.5-flash-lite
# DEFAULT_MODEL_EXPLANATION=google/gemini-2.5-flash-lite
